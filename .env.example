SPARK_BACKEND=docker

HOST_PROJECT_DIR=path_to_project/amazon_reviews

AIRFLOW_VAR_BUCKET_LANDING=landing
AIRFLOW_VAR_BUCKET_BRONZE=bronze
AIRFLOW_VAR_BUCKET_SILVER=silver
AIRFLOW_VAR_BUCKET_GOLD=gold
AIRFLOW_VAR_REVIEWS_CATEGORIES='[
        "All_Beauty"
    ]'
AIRFLOW_CONN_LAKE_S3='{
        "conn_type":"aws",
        "login":"minio",
        "password":"minio123",
        "extra":{"endpoint_url":"http://minio:9000","region_name":"us-east-1"}
    }'
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- AWS (Airflow on EC2, Spark on Glue): replace the values above with these ---
# Run with docker-compose.yaml only (the dev file adds MinIO and the Docker socket).
# HOST_PROJECT_DIR is only needed for the docker backend.
# Credentials come from the EC2 instance role, so the connection holds just the region.
# AIRFLOW_JWT_SECRET=<openssl rand -hex 32>
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_PASSWORD='<strong password>'  # applied on first start only; later: airflow users reset-password
# SPARK_BACKEND=glue
# AIRFLOW_VAR_BUCKET_LANDING=amazon-reviews-landing-<account>-<region>-an
# AIRFLOW_VAR_BUCKET_BRONZE=amazon-reviews-bronze-<account>-<region>-an
# AIRFLOW_VAR_BUCKET_SILVER=amazon-reviews-silver-<account>-<region>-an
# AIRFLOW_VAR_BUCKET_GOLD=amazon-reviews-gold-<account>-<region>-an
# AIRFLOW_CONN_LAKE_S3='{"conn_type":"aws","extra":{"region_name":"eu-north-1"}}'
